# Server-only Google Gemini API settings. Do not use the VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: comma-separated Google emails allowed to use photo recognition. Empty allows any signed-in user.
ALLOWED_EMAILS=

# Server-only Kakao REST API key for the cafe search in the brew log (Kakao Developers > 앱 키 > REST API 키).
# Do not use the VITE_ prefix; the browser only talks to /api/search-cafe.
KAKAO_REST_API_KEY=
